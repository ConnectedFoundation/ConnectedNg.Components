      "@connected-ng/core/permissions": [
        "../../ConnectedNg.Core/src/projects/connected-ng/core/permissions/src/public-api.ts"
      ],
      "@connected-ng/core/users": [
        "../../ConnectedNg.Core/src/projects/connected-ng/core/users/src/public-api.ts"
      ],
      "@connected-ng/core/permission-management": [
        "../../ConnectedNg.Core/src/projects/connected-ng/core/permission-management/src/public-api.ts"
      ]
    },
    "strict": true,
    "noImplicitOverride": true,
    "noPropertyAccessFromIndexSignature": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "ES2022",
    "module": "preserve"
  },
  "angularCompilerOptions": {
    "enableI18nLegacyMessageIdFormat": false,
    "strictInjectionParameters": true,
    "strictInputAccessModifiers": true,
    "strictTemplates": true
  },
  "files": [],
  "references": [
    {
      "path": "./projects/connected-ng/components/tsconfig.lib.json"
    },
    {
      "path": "./projects/connected-ng/components/tsconfig.spec.json"
    }
  ]
