/* To learn more about Typescript configuration file: https://www.typescriptlang.org/docs/handbook/tsconfig-json.html. */
/* To learn more about Angular compiler options: https://angular.dev/reference/configs/angular-compiler-options. */
{
  "extends": "../../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../out-tsc/lib",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "types": [],
    "paths": {
      "@connected-ng/components": ["./src/public-api.ts"],
      "@connected-ng/components/code-lists": ["./code-lists/src/public-api.ts"],
      "@connected-ng/components/code-lists/helpers": ["./code-lists/helpers/src/public-api.ts"],
      "@connected-ng/components/dialogs": ["./dialogs/src/public-api.ts"],
      "@connected-ng/components/forms": ["./forms/src/public-api.ts"],
      "@connected-ng/components/indicators": ["./indicators/src/public-api.ts"],
      "@connected-ng/components/navigation": ["./navigation/src/public-api.ts"],
      "@connected-ng/components/notifications": ["./notifications/src/public-api.ts"]
    }
  },
  "include": ["./**/*.ts"],
  "exclude": ["**/*.spec.ts"]
}
